{
    "singleQuote": false,
    "trailingComma": "all",
    "semi": true,
    "tabWidth": 4,
    "printWidth": 140,
    "jsxSingleQuote": false,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "plugins": ["prettier-plugin-tailwindcss"],
    "organizeImports": true
}
